# Скопируйте в .env и заполните своими значениями. Файл .env в git не попадает.
# Ключ доступа сообщества VK (Управление → Работа с API), права: сообщения, управление
VK_TOKEN=your_vk_community_token
# Числовой ID сообщества (без минуса)
VK_GROUP_ID=123456789
# Ключ Proxy API (proxyapi.ru) — OpenAI-совместимый доступ к GPT
PROXYAPI_KEY=your_proxyapi_key
# VK ID менеджеров через запятую — им приходят заявки (бот должен иметь право им писать)
MANAGER_VK_IDS=111111111
# Модель (необязательно), по умолчанию gpt-4.1
MODEL=gpt-4.1
